<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Properties>
    <Property name="logDir">${sys:harness.log.dir:-logs}</Property>
    <Property name="pattern">%d{HH:mm:ss.SSS} %-5level %-40logger{40} %msg%n</Property>
  </Properties>

  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="${pattern}"/>
    </Console>
    <File name="File" fileName="${logDir}/harness-${date:yyyyMMdd-HHmmss}.log" append="false">
      <PatternLayout pattern="${pattern}"/>
    </File>
  </Appenders>

  <Loggers>
    <!-- Reduce Spark/Hadoop noise -->
    <Logger name="org.apache.spark" level="warn" additivity="false">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="File"/>
    </Logger>
    <Logger name="org.apache.hadoop" level="warn" additivity="false">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="File"/>
    </Logger>
    <Logger name="org.apache.hive" level="warn" additivity="false">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="File"/>
    </Logger>

    <!-- Harness and OL at INFO -->
    <Logger name="io.openlineage" level="info" additivity="false">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="File"/>
    </Logger>
    <!-- SparkPropertyFacetBuilder logs an expected INFO when session stops — suppress it -->
    <Logger name="io.openlineage.spark.agent.facets.builder.SparkPropertyFacetBuilder" level="warn" additivity="false">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="File"/>
    </Logger>

    <Root level="info">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="File"/>
    </Root>
  </Loggers>
</Configuration>
